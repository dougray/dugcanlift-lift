<?xml version="1.0" encoding="utf-8"?>
<!--
   Belt and braces. allowBackup="false" in the manifest already stops Auto
   Backup, but this file is what the tooling reads on API 30 and below, and an
   empty one here reads as "no opinion" rather than "no". Excluding the root
   says it outright.

   The food and workout logs are meant to stay on the device. A user who wants
   a copy takes one from Settings, to a file they choose.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
