<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Route recording (Run/Hike). ACCESS_COARSE_LOCATION is requested
         alongside ACCESS_FINE_LOCATION per current Android guidance, even
         though only the fine-accuracy fix is actually used. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Lets recording continue after the phone locks or the user switches
         apps mid-run. Android 10+ requires this to be granted from system
         settings as a separate step after foreground location is granted —
         see LocationTracker.kt's doc comment; the UI task that requests it
         still needs to be built. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- API 33+: without this, LocationRecordingService still runs and still
         records, but its ongoing notification silently never shows. Not yet
         requested at runtime anywhere — see task-4-report.md. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Read-only: the app displays today's step count but never writes to Health Connect. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <!-- Health Connect hands out only the last 30 days without this. A coach
         asking for a 12-week block would otherwise get a step history that
         stops dead a month back for no visible reason. Optional: refusing it
         costs the older steps and nothing else. -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <!-- allowBackup is off deliberately. Android's Auto Backup would copy the
         food and workout logs to the user's Google Drive, which contradicts
         what this app promises and what its privacy policy says. Backing up is
         something the user does on purpose, from Settings, to a file they
         choose. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DugCanLiftCalc">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:screenOrientation="portrait"
            android:label="@string/app_name"
            android:theme="@style/Theme.App.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            tools:replace="android:screenOrientation" />

        <!-- Required by Health Connect: shown from Settings > Health Connect >
             App permissions when the person wants to see why this app asked
             for step data, without opening the app itself. -->
        <activity
            android:name=".PermissionsRationaleActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".PermissionsRationaleActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Un-bound; holds the ongoing notification required for location
             access once a Run/Hike recording is no longer in the foreground. -->
        <service
            android:name=".LocationRecordingService"
            android:foregroundServiceType="location"
            android:exported="false" />
    </application>
</manifest>