<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- The barcode scanner needs a camera, the rest of the app does not:
         keep the app installable on hardware without one. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Route recording (Run/Hike). ACCESS_COARSE_LOCATION is requested
         alongside ACCESS_FINE_LOCATION per current Android guidance, even
         though only the fine-accuracy fix is actually used. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- No ACCESS_BACKGROUND_LOCATION, on purpose. A recording keeps going
         with the phone locked or another app open because the Start tap
         starts LocationRecordingService, a foregroundServiceType="location"
         service, while the app is visible, and that keeps "while in use"
         location for as long as it runs. Declaring background location
         would need a Play declaration and video for nothing. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- API 33+: without this, LocationRecordingService still runs and still
         records, but its ongoing notification silently never shows.
         Requested at runtime alongside fine/coarse location by
         OutdoorRecordingScreen.kt (Task 6). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The app displays today's step count. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <!-- Health Connect hands out only the last 30 days without this. A coach
         asking for a 12-week block would otherwise get a step history that
         stops dead a month back for no visible reason. Optional: refusing it
         costs the older steps and nothing else. -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />
    <!-- Write side: exporting a finished Run/Hike as an exercise session,
         its GPS route, its distance, and its elevation gain. Each is its own
         separate grant — Health Connect can let an app log a workout without
         letting it log where the user was, how far, or how much they
         climbed — so all four are declared even though this app always asks
         for all four together. -->
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE_ROUTE" />
    <uses-permission android:name="android.permission.health.WRITE_DISTANCE" />
    <uses-permission android:name="android.permission.health.WRITE_ELEVATION_GAINED" />

    <!-- LIFT Link: the Bluetooth LE channel to the LIFT Wear OS watch (watchlink/). The phone is
         the central: it scans once, to pair, and connects to the remembered watch afterwards.
         neverForLocation because a scan here only ever looks for LIFT's own service UUID and
         nothing derives a location from it - which is also what lets Android 12+ grant it
         without the location permission. No ADVERTISE: the phone never advertises. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Android 11 and older, where the two above do not exist. Scanning there also needs
         ACCESS_FINE_LOCATION, which route recording already declares above; nothing new is asked
         for on those versions. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- Not required: a phone without BLE is a phone without a LIFT watch, and everything else in
         the app works the same. -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <!-- allowBackup is off deliberately. Android's Auto Backup would copy the
         food and workout logs to the user's Google Drive, which contradicts
         what this app promises and what its privacy policy says. Backing up is
         something the user does on purpose, from Settings, to a file they
         choose. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DugCanLiftCalc">
        <!-- Resizeable and unlocked in orientation: tablets, foldables and split screen get
             adaptive layouts by window width (ui/adaptive/WindowLayout.kt). Size, orientation
             and fold changes are handled in place rather than by recreating the activity: the
             whole UI is Compose and re-lays itself out, so a half-typed food or set survives a
             rotation or an unfold. The barcode scanner below stays portrait. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:resizeableActivity="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.App.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="www.dugcanlift.com"
                    android:pathPrefix="/lift/" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            tools:replace="android:screenOrientation" />

        <!-- Required by Health Connect: shown from Settings > Health Connect >
             App permissions when the person wants to see why this app asked
             for step data, without opening the app itself. -->
        <activity
            android:name=".PermissionsRationaleActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".PermissionsRationaleActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Un-bound; holds the ongoing notification required for location
             access once a Run/Hike recording is no longer in the foreground.
             Started only from the Start tap, while the app is visible. -->
        <service
            android:name=".LocationRecordingService"
            android:foregroundServiceType="location"
            android:exported="false" />
    </application>
</manifest>
